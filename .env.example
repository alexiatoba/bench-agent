# Pick ONE provider. All three speak the OpenAI chat-completions API.

# 1) NVIDIA NIM (free credits at build.nvidia.com -> "Get API Key")
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=meta/llama-3.3-70b-instruct

# 2) Ollama, fully local on your RTX 4060 (free): `ollama pull qwen2.5:7b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 3) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
